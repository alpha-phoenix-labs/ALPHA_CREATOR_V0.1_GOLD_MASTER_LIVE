APP_NAME=ALPHA CREATOR
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1

# Local zero-setup fallback. Use PostgreSQL for shared and production environments.
DATABASE_URL=sqlite:///./backend/data/alpha_creator.db
# DATABASE_URL=postgresql+psycopg://alpha_creator:change-me@localhost:5432/alpha_creator

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
COLLECTOR_TIMEOUT_SECONDS=10
COLLECTOR_MAX_ITEMS_PER_SOURCE=35
COLLECTOR_RETRIES=1
DEDUPE_THRESHOLD=88
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# Server-side frontend proxy target. In production use the HTTPS Render URL.
ALPHA_BACKEND_URL=http://127.0.0.1:8000

# Frontend data adapter. Keep "api" for the integrated real Core path.
# Use "mock" only for isolated UI-state verification; mock actions do not persist.
NEXT_PUBLIC_ALPHA_DASHBOARD_SOURCE=api
